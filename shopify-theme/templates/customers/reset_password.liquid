<section class="page-hero">
  <div class="container">
    <span class="section-label">Fiók</span>
    <h1>Új jelszó megadása</h1>
    <hr class="gold-hairline gold-hairline--center">
  </div>
</section>

<section class="section">
  <div class="container" style="max-width: 26rem;">
    {%- form 'reset_customer_password', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <p class="form-error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="field">
        <label for="reset-password">Új jelszó</label>
        <input id="reset-password" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>

      <div class="field">
        <label for="reset-password-confirm">Új jelszó megerősítése</label>
        <input id="reset-password-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="btn btn--primary btn--full">Jelszó mentése</button>
    {%- endform -%}
  </div>
</section>
