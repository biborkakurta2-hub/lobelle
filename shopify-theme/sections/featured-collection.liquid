{%- comment -%}
  Kiemelt termékek egy kollekcióból.
{%- endcomment -%}

<section class="section {% if section.settings.deep %}section--deep{% endif %}">
  <div class="container">
    <div class="section-heading text-center fade-in">
      {%- if section.settings.label != blank -%}
        <span class="section-label">{{ section.settings.label }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      <hr class="gold-hairline gold-hairline--center">
    </div>

    <div class="grid grid--3 mt-6">
      {%- for product in section.settings.collection.products limit: section.settings.limit -%}
        <div class="fade-in">{% render 'product-card', product: product %}</div>
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="framed">
            {% render 'corners' %}
            <div class="framed__inner text-center">
              <p class="small muted">Válassz kategóriát a szekció beállításaiban.</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.collection != blank -%}
      <div class="text-center mt-6">
        <a href="{{ section.settings.collection.url }}" class="btn btn--outline">Teljes kategória</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Kiemelt termékek",
  "settings": [
    { "type": "text", "id": "label", "label": "Feliratka", "default": "Kiemelt darabok" },
    { "type": "text", "id": "heading", "label": "Cím", "default": "Népszerű termékeink" },
    { "type": "collection", "id": "collection", "label": "Kategória" },
    { "type": "range", "id": "limit", "label": "Termékek száma", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "checkbox", "id": "deep", "label": "Másodlagos háttér", "default": false }
  ],
  "presets": [{ "name": "Kiemelt termékek" }]
}
{% endschema %}
