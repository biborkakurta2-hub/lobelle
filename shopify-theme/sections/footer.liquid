{%- comment -%}
  Lábléc: középre igazított logó, elérhetőségek, menüoszlopok, jogi linkek,
  közösségi média és copyright.
{%- endcomment -%}

<footer class="footer">
  <div class="container">
    <div class="footer__logo">
      {%- if settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 600 }}"
          alt="{{ shop.name | escape }}"
          width="{{ settings.logo.width }}"
          height="{{ settings.logo.height }}"
        >
      {%- else -%}
        <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1112" height="805">
      {%- endif -%}
    </div>
    <hr class="gold-hairline gold-hairline--center mt-4">

    <div class="footer__grid">
      <div class="footer__col">
        <span class="section-label" style="font-size: 0.65rem;">Elérhetőségek</span>
        <ul>
          {%- if settings.address != blank -%}
            <li>{{ settings.address }}</li>
          {%- endif -%}
          {%- if settings.phone != blank -%}
            <li><a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone }}</a></li>
          {%- endif -%}
          {%- if settings.email != blank -%}
            <li><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' and block.settings.menu != blank -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <span class="section-label" style="font-size: 0.65rem;">
              {{ block.settings.heading | default: block.settings.menu.title }}
            </span>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div class="footer__bottom-row">
        {%- if section.settings.legal_menu != blank -%}
          <ul class="footer__legal">
            {%- for link in section.settings.legal_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <span></span>
        {%- endif -%}

        <ul class="footer__social">
          {%- if settings.social_facebook != blank -%}
            <li>
              <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V9H6v3h3v9h3v-9h3l1-3h-4V6.5a.5.5 0 0 1 .5-.5H15V3z"></path>
                </svg>
                Facebook
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_instagram != blank -%}
            <li>
              <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none"></circle>
                </svg>
                Instagram
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      <p class="footer__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }} &middot; Minden jog fenntartva
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Lábléc",
  "settings": [
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Jogi linkek menü",
      "info": "ÁSZF, Adatkezelési tájékoztató, Elállási tájékoztató."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menüoszlop",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Oszlop címe"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menü"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu" },
      { "type": "menu" },
      { "type": "menu" }
    ]
  }
}
{% endschema %}
