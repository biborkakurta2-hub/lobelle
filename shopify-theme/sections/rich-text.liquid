{%- comment -%}
  Szabad szöveges szekció — Rólunk, küldetés, bármilyen hosszabb tartalom.
{%- endcomment -%}

<section class="section {% if section.settings.deep %}section--deep{% endif %}">
  <div class="container" style="max-width: {% if section.settings.narrow %}48rem{% else %}72rem{% endif %};">
    <div class="{% if section.settings.center %}text-center{% endif %} fade-in">
      {%- if section.settings.label != blank -%}
        <span class="section-label">{{ section.settings.label }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="mt-2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.label != blank or section.settings.heading != blank -%}
        <hr class="gold-hairline {% if section.settings.center %}gold-hairline--center{% endif %}">
      {%- endif -%}
    </div>

    {%- if section.settings.text != blank -%}
      <div class="rte muted mt-4 fade-in">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="{% if section.settings.center %}text-center{% endif %} mt-4">
        <a href="{{ section.settings.cta_link }}" class="btn btn--primary">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Szöveg",
  "settings": [
    { "type": "text", "id": "label", "label": "Feliratka" },
    { "type": "text", "id": "heading", "label": "Cím" },
    { "type": "richtext", "id": "text", "label": "Szöveg" },
    { "type": "text", "id": "cta_label", "label": "Gomb felirata" },
    { "type": "url", "id": "cta_link", "label": "Gomb hivatkozása" },
    { "type": "checkbox", "id": "center", "label": "Középre igazítás", "default": true },
    { "type": "checkbox", "id": "narrow", "label": "Keskeny szövegoszlop", "default": true },
    { "type": "checkbox", "id": "deep", "label": "Másodlagos háttér", "default": false }
  ],
  "presets": [{ "name": "Szöveg" }]
}
{% endschema %}
