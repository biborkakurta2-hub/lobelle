{%- comment -%}
  Titánium előnyök rácsa — a brosúra 3. oldala nyomán.
{%- endcomment -%}

<section class="section {% if section.settings.deep %}section--deep{% endif %}">
  <div class="container">
    <div class="section-heading text-center fade-in">
      {%- if section.settings.label != blank -%}
        <span class="section-label">{{ section.settings.label }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      <hr class="gold-hairline gold-hairline--center">
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="grid grid--3 grid--wide mt-6">
      {%- for block in section.blocks -%}
        <div class="benefit fade-in" {{ block.shopify_attributes }}>
          <span class="diamond" style="margin-top: 0.4rem;" aria-hidden="true">&#9670;</span>
          <div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Előnyök",
  "settings": [
    { "type": "text", "id": "label", "label": "Feliratka", "default": "Anyag és technológia" },
    { "type": "text", "id": "heading", "label": "Cím", "default": "A titánium ereje" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Bevezető",
      "default": "A titánium jelenleg a világ egyik legbiztonságosabb fémje füllyukasztáshoz. Nem véletlen, hogy orvosi implantátumoknál is ezt használják: gyorsabb gyógyulás, kevesebb gyulladás, minimális irritáció."
    },
    { "type": "checkbox", "id": "deep", "label": "Másodlagos háttér", "default": true }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Előny",
      "settings": [
        { "type": "text", "id": "title", "label": "Cím" },
        { "type": "textarea", "id": "text", "label": "Szöveg" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Előnyök",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Teljesen nikkelmentes", "text": "A leggyakoribb allergén nélkül — érzékeny bőrnek is." } },
        { "type": "benefit", "settings": { "title": "Biokompatibilis", "text": "A szervezet sajátjaként fogadja, nem lép reakcióba a bőrrel." } },
        { "type": "benefit", "settings": { "title": "Nem oxidálódik", "text": "Évek múlva is ugyanolyan, mint az első napon." } },
        { "type": "benefit", "settings": { "title": "Nem korrodál", "text": "Víz, izzadság, kozmetikum — semmi nem árt neki." } },
        { "type": "benefit", "settings": { "title": "Nem színeződik el", "text": "Tartós, elegáns megjelenés kompromisszum nélkül." } },
        { "type": "benefit", "settings": { "title": "Kíméletes kivitel", "text": "Rendkívül vékony szár — a lyukasztás alig érezhető." } }
      ]
    }
  ]
}
{% endschema %}
