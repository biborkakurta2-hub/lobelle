{%- if section.settings.text != blank -%}
  <div class="note-bar">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Hirdetősáv",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Szöveg",
      "info": "Hagyd üresen, ha nem kell sáv."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Hivatkozás"
    }
  ]
}
{% endschema %}
