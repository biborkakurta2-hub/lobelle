{%- comment -%}
  Kategórialista oldal.
{%- endcomment -%}

<section class="page-hero">
  <div class="container">
    <span class="section-label">Kollekció</span>
    <h1>{{ page_title }}</h1>
    <hr class="gold-hairline gold-hairline--center">
    <p class="lede">
      Minden darab ugyanabból az alapanyagból, ugyanazzal az igényességgel készül — a
      legkisebbeknek szánt első fülbevalótól a professzionális eszközökig.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid--3">
      {%- for collection in collections -%}
        <div class="fade-in">
          <a href="{{ collection.url }}" class="product-card">
            <div class="framed">
              {% render 'corners' %}
              <div class="framed__inner">
                <div class="product-card__media">
                  {%- if collection.featured_image -%}
                    <img
                      src="{{ collection.featured_image | image_url: width: 700 }}"
                      alt="{{ collection.title | escape }}"
                      width="700"
                      height="700"
                      loading="lazy"
                    >
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <h2 class="product-card__title">{{ collection.title }}</h2>
                {%- if collection.description != blank -%}
                  <p class="small muted mt-1">{{ collection.description | strip_html | truncate: 110 }}</p>
                {%- endif -%}
                <div class="product-card__foot">
                  <span class="product-card__more">Megnézem</span>
                </div>
              </div>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategórialista",
  "settings": []
}
{% endschema %}
