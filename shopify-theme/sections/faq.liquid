{%- comment -%}
  Gyakori kérdések — akadálymentes accordion aria attribútumokkal.
{%- endcomment -%}

<section class="section">
  <div class="container" style="max-width: 48rem;">
    <div class="section-heading text-center fade-in">
      {%- if section.settings.label != blank -%}
        <span class="section-label">{{ section.settings.label }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      <hr class="gold-hairline gold-hairline--center">
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="accordion mt-6 fade-in">
      {%- for block in section.blocks -%}
        <div class="accordion__item" {{ block.shopify_attributes }}>
          <h3 style="margin: 0;">
            <button
              type="button"
              class="accordion__button"
              data-accordion-button
              id="faq-button-{{ section.id }}-{{ forloop.index }}"
              aria-controls="faq-panel-{{ section.id }}-{{ forloop.index }}"
              aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              <span>{{ block.settings.question }}</span>
              <svg class="accordion__icon" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.2"></path>
              </svg>
            </button>
          </h3>
          <div
            class="accordion__panel"
            id="faq-panel-{{ section.id }}-{{ forloop.index }}"
            role="region"
            aria-labelledby="faq-button-{{ section.id }}-{{ forloop.index }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            {{ block.settings.answer }}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="text-center mt-6 fade-in">
        {%- if section.settings.cta_text != blank -%}
          <p class="small muted">{{ section.settings.cta_text }}</p>
        {%- endif -%}
        <a href="{{ section.settings.cta_link }}" class="btn btn--primary mt-3">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gyakori kérdések",
  "settings": [
    { "type": "text", "id": "label", "label": "Feliratka", "default": "Segítünk eligazodni" },
    { "type": "text", "id": "heading", "label": "Cím", "default": "Gyakori kérdések" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Bevezető",
      "default": "Összegyűjtöttük a leggyakrabban felmerülő kérdéseket a füllyukasztásról, a titániumról és az utóápolásról."
    },
    { "type": "text", "id": "cta_text", "label": "Záró szöveg", "default": "Nem találtad meg a választ a kérdésedre?" },
    { "type": "text", "id": "cta_label", "label": "Gomb felirata", "default": "Tedd fel nekünk" },
    { "type": "url", "id": "cta_link", "label": "Gomb hivatkozása" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Kérdés",
      "settings": [
        { "type": "text", "id": "question", "label": "Kérdés" },
        { "type": "richtext", "id": "answer", "label": "Válasz" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gyakori kérdések",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Fáj a füllyukasztás?",
            "answer": "<p>A Lobelle rendszer rendkívül vékony titánium szárral dolgozik, ezért a lyukasztás alig érezhető — egy rövid, enyhe csípéshez hasonlítható. A professzionális készülék egyetlen gyors mozdulattal végzi el a lyukasztást.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Mennyi a gyógyulási idő?",
            "answer": "<p>Fülcimpa esetén a teljes gyógyulás általában 6–8 hét. A titánium biokompatibilis anyaga a tapasztalatok szerint gyorsabb gyógyulást, kevesebb gyulladást és minimális irritációt jelent más fémekhez képest.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Hány éves kortól lyukasztható a babák füle?",
            "answer": "<p>A babafül-lyukasztás a kötelező védőoltások beadása után, jellemzően 3–4 hónapos kortól ajánlott — a pontos időzítésről érdemes a gyermekorvossal is egyeztetni.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Miben más a titán, mint az orvosi fém?",
            "answer": "<p>Az orvosi fém néven forgalmazott ékszerek többsége sebészeti acél, amely tartalmazhat nikkelt. Az ASTM F136 szabványú, Grade 23 titán ezzel szemben teljesen nikkelmentes és biokompatibilis.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Hogyan ápoljam a friss fül-lyukat?",
            "answer": "<p>Naponta kétszer tisztítsd a lyukasztás környékét az utóápoló oldattal, előtte moss kezet. Az ékszert a gyógyulás alatt ne vedd ki. Uszoda, szauna és állóvíz az első hetekben kerülendő.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Van korhatára a füllyukasztásnak?",
            "answer": "<p>Felfelé nincs korhatár. 18 év alatt szülői vagy törvényes képviselői beleegyezés szükséges, amelyet írásos hozzájárulási nyilatkozattal rögzítünk.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
