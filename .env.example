# Shopify webshop — másold át .env.local néven, és töltsd ki
#
# Amíg ezek üresek, az oldal a data/products.json helyi termékadataival
# működik, és a rendelés e-mailben érkezik. Kitöltve a termékek, árak és
# a készlet a Shopify boltból jönnek, a fizetés pedig a Shopify oldalán.
#
# Honnan szerezd be:
#   1. Shopify admin → Beállítások → Alkalmazások és értékesítési csatornák
#   2. "Alkalmazásfejlesztés" → Alkalmazás létrehozása (név: pl. "Weboldal")
#   3. Storefront API → engedélyezd: unauthenticated_read_product_listings,
#      unauthenticated_read_product_inventory, unauthenticated_write_checkouts
#   4. Telepítsd az alkalmazást, majd másold ki a Storefront API tokent

# A bolt címe, .myshopify.com végződéssel
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Storefront API token (nyilvános, böngészőből is használható)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Formspree űrlap végpont — a kapcsolati és érdeklődő űrlapokhoz
# (a megrendelés Shopify esetén nem ezen megy)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
